# Copy to backend/.env for local development. The installed desktop app doesn't use this file
# (keys are entered in Settings there).

# History storage: set MONGO_URL to use MongoDB, or leave it empty to use a local SQLite file
# (%LOCALAPPDATA%\Point\point.db, or POINT_DATA_DIR if set).
MONGO_URL=mongodb://localhost:27017
DB_NAME=point
CORS_ORIGINS=http://localhost:3000,http://tauri.localhost,https://tauri.localhost

# AI providers: set at least one. Model names are optional overrides of the defaults in server.py.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# OCR: path to tesseract.exe if it isn't on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Web search: a local SearXNG instance. If it isn't running, search falls back to DuckDuckGo.
SEARXNG_URL=http://localhost:8888

# Optional integrations.
NOTION_API_KEY=
GITHUB_PAT_TOKEN=
