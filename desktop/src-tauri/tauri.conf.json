{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spatial AI Context Layer",
  "version": "0.2.0",
  "identifier": "com.spatialai.contextlayer",
  "build": {
    "frontendDist": "../../frontend/build",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "capture",
        "title": "Spatial AI Capture",
        "url": "/capture",
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "width": 1440,
        "height": 900
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "Spatial AI",
    "shortDescription": "Point at anything on screen and use it as structured AI context.",
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {"installMode": "perMachine", "displayLanguageSelector": false},
      "wix": {"language": "en-US"}
    }
  }
}