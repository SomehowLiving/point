{
  "manifest_version": 3,
  "name": "Spatial AI Context Layer",
  "version": "0.2.0",
  "description": "Select visible web context and send it to Spatial AI.",
  "permissions": ["activeTab", "tabs", "storage", "scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lens.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {"default_title": "Capture with Spatial AI"},
  "commands": {
    "capture-context": {
      "suggested_key": {"default": "Alt+Shift+S", "windows": "Alt+Shift+S"},
      "description": "Capture visible context"
    },
    "capture-full-page": {
      "suggested_key": {"default": "Alt+Shift+F", "windows": "Alt+Shift+F"},
      "description": "Capture full scrolling page"
    },
    "toggle-lens": {
      "suggested_key": {"default": "Alt+Shift+L", "windows": "Alt+Shift+L"},
      "description": "Toggle Real-Time Lens"
    }
  }
}